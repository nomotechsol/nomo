# Read-only setup. Keep real credentials out of this file and Git.
HELIUS_RPC_URL=
SOLANA_CLUSTER=mainnet
BSC_RPC_URL=https://bsc-rpc.publicnode.com
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_START_BLOCK=
RH_START_BLOCK=
FILTERS_FILE=./config/filters.example.json
GMGN_API_KEY=
# Optional legacy read-only EVM swap quotes. BNB and RH execution use public Relay routes.
ZEROX_API_KEY=
MAIN_TOKEN_MINT=
MAIN_TOKEN_LP_POOL=
MAIN_TOKEN_DECIMALS=6
# Live Solana mode accepts NOMO before migration: its curve must quote PUMP.
# MAIN_TOKEN_LP_POOL must be the canonical NOMO/PUMP PumpSwap pool address. Its
# identity is checked even before migration; the on-chain pool is checked when it appears.
# Keep both keypair JSON
# files outside this repository with mode 0600. Never paste keys into the UI.
SOLANA_TREASURY_KEYPAIR_PATH=
# The reward wallet pays SOL network fees and ATA rent for automatic Solana delivery.
SOLANA_REWARD_KEYPAIR_PATH=
# BNB treasury receives the bridge and buys; reward wallet holds the 70% holder pool.
# Both files must be outside this repository, contain a 0x-prefixed 32-byte hex key,
# and have mode 0600. Do not paste private keys into the site or logs.
BSC_TREASURY_KEY_PATH=
BSC_REWARD_KEY_PATH=
BSC_GAS_RESERVE_WEI=2000000000000000
# Robinhood Chain: the same two EVM key files used for BNB may be reused here.
# The treasury receives bridged ETH and buys Pons V2; the reward wallet sends claims.
RH_TREASURY_KEY_PATH=
RH_REWARD_KEY_PATH=
RH_GAS_RESERVE_WEI=2000000000000000
PORT=8789
PUBLIC_ORIGIN=http://127.0.0.1:8789
DATABASE_PATH=./data/nomo.db
# Set true only after checking the mint, backend wallets and treasury.
# Solana Pump.fun and StonkFun purchases.
LIVE_TRADING=false
# Also enable Flap tax/non-tax and Four.meme after the NOMO mint and wallets are ready.
LIVE_BSC_TRADING=false
# Also enable Pons V2 purchases and direct EVM claims on Robinhood Chain.
LIVE_RH_TRADING=false
